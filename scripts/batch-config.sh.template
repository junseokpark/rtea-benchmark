#!/bin/bash
# SLURM Batch Job Configuration Template
# Copy this file to batch-config.sh and customize for your cluster
#
# This file allows you to customize SBATCH settings without modifying the
# main processing scripts.
#
# Usage:
#   1. Copy this file: cp batch-config.sh.template batch-config.sh
#   2. Edit batch-config.sh with your desired SBATCH settings
#   3. The scripts will automatically source batch-config.sh if it exists

# ============================================
# SBATCH Job Settings
# ============================================

# Job time limit (format: HH:MM:SS or D-HH:MM:SS)
export BATCH_TIME="24:00:00"

# Memory allocation per job
export BATCH_MEM="32G"

# Number of CPUs per task
export BATCH_CPUS="8"

# SLURM partition/queue name (optional, uses cluster default if not set)
# Examples: "compute", "normal", "short", "long", "gpu"
export SLURM_PARTITION=""

# Job name prefix (will be appended with batch-specific suffix)
export BATCH_JOB_NAME="TE_analysis"

# Output and error log directory (relative to sample_list_dir or script location)
export BATCH_LOG_DIR="logs"

# Additional SBATCH options (uncomment and modify as needed)
# Account/project for billing
# export BATCH_ACCOUNT="myaccount"

# Quality of Service (QOS)
# export BATCH_QOS="normal"

# Node constraints/features
# export BATCH_CONSTRAINT="haswell"

# Exclude specific nodes
# export BATCH_EXCLUDE="node001,node002"

# Email notifications
# export BATCH_MAIL_TYPE="END,FAIL"
# export BATCH_MAIL_USER="user@example.com"

# ============================================
# Notes
# ============================================
# - These settings will be used if batch-config.sh is sourced
# - Settings can be overridden at submission time via command-line arguments
# - If not set, scripts will use their built-in safe defaults
#
# ============================================
# Example Configurations by Cluster
# ============================================
#
# SLURM cluster with partitions:
#   export SLURM_PARTITION="compute"
#   export BATCH_TIME="48:00:00"
#   export BATCH_MEM="64G"
#   export BATCH_CPUS="16"
#
# PBS/Torque cluster (note: these scripts are SLURM-specific):
#   # You would need to adapt the scripts for PBS/Torque
#
# Local workstation (no SLURM):
#   # Run process_batch_worker.sh directly without sbatch
#
# ============================================

